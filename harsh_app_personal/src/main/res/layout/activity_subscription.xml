<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════ -->
        <!--            HERO SECTION                 -->
        <!-- ═══════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_paywall_hero">

            <!-- Subtle football pitch lines overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:alpha="0.04"
                android:background="#FFFFFF" />

            <!-- Top bar: VIP badge + Close button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- VIP Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vip_badge"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="VIP MEMBERSHIP"
                        android:textColor="#FFD700"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="0dp"/>


                <!-- Close Button -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_close_button"
                    android:padding="7dp"
                    android:contentDescription="Close" />
            </LinearLayout>

            <!-- Hero Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="56dp"
                android:paddingBottom="28dp">

                <!-- Football emoji graphic -->


                <!-- Plan Title -->

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvPlanTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correct Score"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="5dp"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="1.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚽"
                        android:textSize="32sp"
                        android:layout_marginBottom="10dp" />
                </androidx.appcompat.widget.LinearLayoutCompat>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIP Predictions"
                    android:textColor="#7C6EF5"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expert tips. Verified results. Unlock today's picks."
                    android:textColor="#9090AA"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </FrameLayout>

        <!-- ═══════════════════════════════════════ -->
        <!--           STATS STRIP                   -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stats_strip"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-35dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="94%"
                    android:textColor="#00D97E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Win Rate"
                    android:textColor="#666680"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#22222E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50K+"
                    android:textColor="#7C6EF5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Members"
                    android:textColor="#666680"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#22222E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 7"
                    android:textColor="#FF8C42"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Win Streak"
                    android:textColor="#666680"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!--      TODAY'S LOCKED PICKS TEASER        -->
        <!-- ═══════════════════════════════════════ -->


        <!-- ═══════════════════════════════════════ -->
        <!--         RECENT WINS STRIP               -->
        <!-- ═══════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════ -->
        <!--         FEATURES (WHAT'S INCLUDED)      -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:background="#FFD700"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What's Included"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include layout="@layout/item_feature"
                android:id="@+id/feature1" />

            <include layout="@layout/item_feature"
                android:id="@+id/feature2" />

            <include layout="@layout/item_feature"
                android:id="@+id/feature3" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!--         USER REVIEWS                    -->
        <!-- ═══════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════ -->
        <!--       SUBSCRIPTION PLAN CARDS           -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp">



            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:background="@drawable/bg_loader"
                android:layout_marginBottom="10dp">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminateTint="#7C6EF5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading plans..."
                    android:textColor="#666680"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ─────────────────────────────── -->
            <!-- Monthly Plan Card (RECOMMENDED) -->
            <!-- ─────────────────────────────── -->

            <!-- ─────────────────────────────── -->
            <!--   Weekly Plan Card              -->
            <!-- ─────────────────────────────── -->
            <FrameLayout
                android:id="@+id/planWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plan_card_unselected"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWeeklyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWeeklySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Try before you commit"
                                android:textColor="#888899"
                                android:textSize="11sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvWeeklyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$4.99"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per week"
                                android:textColor="#888899"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/planMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plan_card_selected"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvMonthlyTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Monthly"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvMonthlySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best value for serious punters"
                                android:textColor="#ffffff"
                                android:textSize="11sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvMonthlyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$14.99"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per month"
                                android:textColor="#10B981"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#10B981"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Bottom row: savings + popular badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💰  Save 40% vs weekly plan"
                            android:textColor="#ffffff"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/badgeMonthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOST POPULAR"
                            android:textColor="#0A0A0F"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:background="@drawable/bg_popular_badge"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>


        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!--    MONEY-BACK GUARANTEE BANNER          -->
        <!-- ═══════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════ -->
        <!--          CTA SECTION                    -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Subscribe CTA Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubscribe"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⚡  Get VIP Access Now"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:background="@drawable/bg_subscribe_button"
                android:stateListAnimator="@null" />

            <!-- Legal row -->
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#444455"
                    android:textSize="11sp"
                    android:padding="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="#444455"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restore Purchases"
                    android:textColor="#444455"
                    android:textSize="11sp"
                    android:padding="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="#444455"
                    android:textSize="11sp" />


            </LinearLayout>






        </LinearLayout>

    </LinearLayout>
</ScrollView>