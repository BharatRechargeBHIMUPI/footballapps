<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  item_vip_promo_card.xml — "STREAK STRIP" REDESIGN v5         ║
    ║  Theme:   Cosmic Dark                                         ║
    ║  Concept: a 7-day streak tracker, not a "see everything"      ║
    ║  pitch. Reinforces the single 2+ Odds VIP product with proof  ║
    ║  instead of repeating the dial above.                         ║
    ║  btnVip ID unchanged — Kotlin click listener untouched.        ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vipPromoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="6dp"
    android:elevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_promo_card_cosmic">

        <!-- ── TOP: label + streak count ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THIS WEEK'S STREAK"
                    android:textColor="@color/section_label"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="7 Picks. 7 Wins."
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Streak badge -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_count_badge_circle_cosmic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔥"
                    android:textSize="20sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── MIDDLE: 7-day dot tracker ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:weightSum="7">

            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:background="@drawable/bg_streak_dot_win" android:layout_marginStart="5dp" />
        </LinearLayout>

        <!-- ── DESCRIPTION + CTA ─────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="One 2+ Odds pick a day. Subscribe once, get every pick."
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/btnVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCK"
                android:textColor="@color/black"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:fontFamily="sans-serif-condensed"
                android:background="@drawable/bg_cta_gold_cosmic"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp" />
        </LinearLayout>

        <!-- ── BOTTOM STRIP — social proof ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/bg_promo_bottom_strip_cosmic"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 50,000+ members  ·  Cancel anytime"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>