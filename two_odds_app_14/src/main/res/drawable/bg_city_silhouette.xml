<?xml version="1.0" encoding="utf-8"?>
<!-- bg_city_silhouette.xml
     Dark city skyline that fills the bottom 45% of screen.
     Pure black/near-black fills — buildings silhouetted against the space sky.
     Uses vector drawable for crisp rendering at all densities. -->
