<?xml version="1.0" encoding="utf-8"?>
<!-- Host View needs android:layerType="software" or dashes won't render. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1dp"
        android:color="#C0BBAC"
        android:dashWidth="5dp"
        android:dashGap="4dp" />
</shape>
