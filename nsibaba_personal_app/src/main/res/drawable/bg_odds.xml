<!-- res/drawable/bg_odds_card.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark background -->
    <solid android:color="#0B1F14"/>

    <!-- Rounded corners -->
    <corners android:radius="8dp"/>

    <!-- Green border -->
    <stroke
        android:width="1dp"
        android:color="#00FF66"/>

    <!-- Padding -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="6dp"
        android:bottom="6dp"/>
</shape>