<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════╗
    ║  SPLASH SCREEN — STADIUM FLOODLIGHT REDESIGN             ║
    ║  Aesthetic: Tactical pitch map + stadium architecture     ║
    ║  Palette:   Deep forest #0B1A0F  |  Gold #D4A843         ║
    ║             Chalk white #F0F4EC  |  Turf #1A3320         ║
    ║  All View IDs are IDENTICAL to original — logic untouched ║
    ╚══════════════════════════════════════════════════════════╝
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"    android:background="@color/app_bg"
    >

    <!-- ═══════════════════════════════════════════════════════
         LAYER 1 — PITCH HALF-CIRCLE TOP ARC (decorative)
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pitch_lines"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════════════════
         LAYER 2 — RADIAL STADIUM GLOW (centre circle)
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/bgGlow"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_center_glow"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3" />

    <!-- ═══════════════════════════════════════════════════════
         LAYER 3 — EXPANDING RINGS (IDs kept identical)
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/ring1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_gold"
        android:alpha="0" />

    <View
        android:id="@+id/ring2"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_gold"
        android:alpha="0" />

    <View
        android:id="@+id/ring3"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_gold"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════════════════
         TOP CORNER — MATCH STAT BADGES (pure decoration)
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="end"
        android:alpha="0.35">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIN RATE"
            android:textColor="#D4A843"
            android:textSize="7sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="87%"
            android:textColor="#000000"
            android:textSize="20sp"
            android:letterSpacing="-0.02"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="52dp"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:gravity="start"
        android:alpha="0.35">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="#D4A843"
            android:textSize="7sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12\nTIPS"
            android:textColor="#000000"
            android:textSize="20sp"
            android:letterSpacing="-0.02"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="0.9" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT BLOCK — shifted slightly above centre
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_marginTop="-40dp">

        <!-- ── LOGO FRAME ─────────────────────────────────── -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center">

            <!-- Slow-rotating outer ring (hex/pentagon feel) -->
            <ImageView
                android:id="@+id/hexRing"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_logo_ring"
                android:alpha="0"
                android:scaleX="0.5"
                android:scaleY="0.5" />

            <!-- Gold halo ring tight around logo -->
            <View
                android:id="@+id/logoRing"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_halo_gold"
                android:alpha="0"
                android:scaleX="0.6"
                android:scaleY="0.6" />

            <!-- App logo -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_logo"
                android:alpha="0"
                android:scaleX="0.2"
                android:scaleY="0.2" />

        </FrameLayout>

        <!-- ── VERTICAL DIVIDER WITH DIAMOND ─────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:background="#3AD4A843" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_diamond_gold"
                android:rotation="45" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:background="#3AD4A843" />

        </LinearLayout>

        <!-- ── APP NAME ───────────────────────────────────── -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            android:text="@string/app_name"
            android:textColor="#000000"
            android:textSize="32sp"
            android:letterSpacing="0.10"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:translationY="50dp"
            android:alpha="0" />

        <!-- ── ANIMATED GOLD UNDERLINE ────────────────────── -->
        <View
            android:id="@+id/underlineAccent"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_underline_gold_gradient" />

        <!-- ── TAGLINE ────────────────────────────────────── -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="PREDICT  •  WIN  •  DOMINATE"
            android:textColor="#BDD4A843"
            android:textSize="10sp"
            android:letterSpacing="0.28"
            android:fontFamily="sans-serif-condensed"
            android:translationY="30dp"
            android:alpha="0" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         BOTTOM SECTION
    ════════════════════════════════════════════════════════ -->

    <!-- Gold progress bar — wider & thinner for elegance -->
    <FrameLayout
        android:id="@+id/loadingBarContainer"
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/dotsLayout"
        android:layout_marginBottom="24dp"
        android:background="#1DF0F4EC"
        android:alpha="0">

        <View
            android:id="@+id/loadingBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_loading_bar_gold" />

    </FrameLayout>

    <!-- Loading dots — square style for tactical feel -->
    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/poweredBy"
        android:layout_marginBottom="18dp"
        android:alpha="0">

        <View
            android:id="@+id/dot1"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dot_gold_square" />

        <View
            android:id="@+id/dot2"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dot_gold_square" />

        <View
            android:id="@+id/dot3"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_dot_gold_square" />

    </LinearLayout>

    <!-- Powered by — subtle, refined -->
    <TextView
        android:id="@+id/poweredBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:text="POWERED BY ACEAPPS"
        android:textColor="#40F0F4EC"
        android:textSize="8sp"
        android:letterSpacing="0.24"
        android:fontFamily="sans-serif-condensed"
        android:alpha="0" />

</RelativeLayout>