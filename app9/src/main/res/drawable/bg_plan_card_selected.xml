<?xml version="1.0" encoding="utf-8"?>
<!--
    Selected / highlighted plan card — layer-list
    Layer 1: Navy gradient fill (semi-transparent)
    Layer 2: Navy border stroke (solid, 2dp)
    Theme: Light Mode · Deep Navy Blue
    Usage: active/recommended plan card on paywall
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: gradient fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4D1A2E6C"
                android:endColor="#1A0A1535"
                android:angle="135" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 2: border stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#1A2E6C" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>