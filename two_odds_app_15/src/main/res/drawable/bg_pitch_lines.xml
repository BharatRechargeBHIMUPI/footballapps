<?xml version="1.0" encoding="utf-8"?>
<!-- bg_pitch_lines.xml — repurposed as star scatter overlay -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Diagonal star streaks at ultra-low opacity -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#08FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#05C060FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
