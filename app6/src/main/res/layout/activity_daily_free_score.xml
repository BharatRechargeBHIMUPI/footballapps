<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_daily_free_match.xml — Upgraded UI
  ─────────────────────────────────────────────
  New colors needed in colors.xml:
    tab_active_bg     → #F0A500
    tab_inactive_bg   → #13161F
    tab_active_text   → #0D0F14
    tab_inactive_text → #5A6070
    note_bg           → #1A1D27
    note_text         → #8A9BB0
    bottom_total_text → #F0A500
    divider_line      → #1A1D27
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════ -->
    <!--  TOP HEADER BAR                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <!-- Back Button circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1D27"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    android:tint="@color/white"
                    android:contentDescription="Back" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Daily Free Match"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- Live pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_live_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_circle_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="LIVE"
                    android:textColor="@color/live_dot_color"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  NOTE STRIP                                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:id="@+id/txtNote"
        android:background="@drawable/bg_note_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_info"
            android:tint="#ffffff"
            android:contentDescription="Note" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Stake games singles before combining"
            android:textColor="#8A9BB0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  TAB SWITCHER                                   -->
    <!-- ═══════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabToday"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@color/vip_card"
                android:gravity="center"
                android:text="TODAY"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tabYesterday"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tab_inactive"
                android:gravity="center"
                android:text="YESTERDAY"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  MATCHES LIST                                   -->
    <!-- ═══════════════════════════════════════════════ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />




            <TextView
                android:id="@+id/txtNoHistory"
                android:visibility= "gone"
                android:layout_width="wrap_content"
                android:layout_centerInParent="true"
                android:layout_height="wrap_content"
                android:text="No games yet"
                android:textColor="#3E4455"
                android:textSize="14sp"
                android:textStyle="bold" />



    </RelativeLayout>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  BOTTOM TOTAL BAR                               -->
    <!-- ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <!-- Top divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="#1A1D27" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMBINED ODDS"
                    android:textColor="#3E4455"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/vip_amber"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Accumulator label -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1B3326"
                app:strokeWidth="1dp"
                app:strokeColor="@color/live_border">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="ACCUMULATOR"
                    android:textColor="@color/live_dot_color"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>