<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040C06"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════════
             SECTION 1 — NAV BAR (minimal)
        ════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════
             SECTION 2 — VAULT HERO CARD
             (replaces old hero-image block entirely)
        ════════════════════════════════════════════════════════ -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_paywall_hero">

                <!-- Ambient glow circle -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_center_glow"
                    android:alpha="0.18" />

                <!-- Corner accent: top-left -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="18dp"
                    android:background="@color/app_primary" />
                <View
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="18dp"
                    android:background="@color/app_primary" />

                <!-- Corner accent: bottom-right -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="18dp"
                    android:background="@color/app_primary" />
                <View
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="18dp"
                    android:background="@color/app_primary" />

                <!-- Center content -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Lock icon -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐"
                        android:textSize="42sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Plan title dynamic -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvPlanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Correct Score"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚽"
                            android:textSize="20sp"
                            android:layout_marginBottom="4dp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIP Predictions"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="bottom|center"
                        android:layout_marginBottom="14dp"
                        android:text="Expert tips. Verified results. Unlock today's picks."
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <!-- Bottom micro-text -->

            </FrameLayout>



                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnClose"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_close"
                    android:layout_margin="20dp"
                    android:background="@drawable/bg_close_button"
                    android:contentDescription="Close" />


        </RelativeLayout>

        <!-- ═══════════════════════════════════════════════════════
             SECTION 3 — STATS ROW (3 pill blocks, side by side)
        ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="10dp">

            <!-- Win Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stats_strip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="99%"
                        android:textColor="#00C853"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Win Rate"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Members -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stats_strip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50K+"
                        android:textColor="@color/app_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Members"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stats_strip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="×7"
                        android:textColor="#FFB800"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streak"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             SECTION 4 — WHAT'S INCLUDED
             (3 horizontal accent-bar rows)
        ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="22dp">

            <!-- Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S INCLUDED"
                android:textColor="@color/app_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:layout_marginBottom="14dp" />

            <include
                layout="@layout/item_feature"
                android:id="@+id/feature1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                layout="@layout/item_feature"
                android:id="@+id/feature2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                layout="@layout/item_feature"
                android:id="@+id/feature3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             SECTION 5 — PLAN CARDS
             Full-width stacked "access keycard" style
        ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="6dp">

            <!-- Loading state -->
            <LinearLayout
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/bg_loader"
                android:layout_marginBottom="10dp">

                <ProgressBar
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="@color/app_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Loading plans..."
                    android:textColor="#2E5E36"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ── WEEKLY CARD — "keycard" horizontal layout ── -->
            <FrameLayout
                android:id="@+id/planWeekly"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_plan_card_unselected"
                android:layout_marginBottom="10dp"
                android:visibility="gone">



                <!-- Inner layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <!-- Left: labels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeeklyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeeklySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Try before you commit"
                            android:textColor="#767272"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Right: price -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvWeeklyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$4.99"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="per week"
                            android:textColor="#767272"
                            android:textSize="9sp"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ── MONTHLY CARD — highlighted keycard ── -->
            <FrameLayout
                android:id="@+id/planMonthly"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_plan_card_selected"
                android:layout_marginBottom="10dp"
                android:visibility="gone">


                <!-- Badge top right -->
                <TextView
                    android:id="@+id/badgeMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:text="MOST POPULAR"
                    android:textColor="#040C06"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="@drawable/bg_popular_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />

                <!-- Inner layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <!-- Left: labels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMonthlyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMonthlySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Best value for serious punters"
                            android:textColor="#00C853"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 Save 40% vs weekly"
                            android:textColor="#ffffff"
                            android:textSize="9sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Right: price -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvMonthlyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$14.99"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="per month"
                            android:textColor="#00C853"
                            android:textSize="9sp"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             SECTION 6 — TRUST ROW
        ════════════════════════════════════════════════════════ -->


        <!-- ═══════════════════════════════════════════════════════
             SECTION 7 — CTA + LEGAL
        ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubscribe"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="⚡  GET VIP ACCESS NOW"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_subscribe_button"
                android:stateListAnimator="@null" />

            <!-- Legal -->
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#1A3020"
                    android:textSize="10sp"
                    android:padding="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="#1A3020"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restore Purchases"
                    android:textColor="#1A3020"
                    android:textSize="10sp"
                    android:padding="6dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>