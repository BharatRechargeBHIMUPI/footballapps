<?xml version="1.0" encoding="utf-8"?>
<!-- Promo card base — dark slate with subtle cyan left border feel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E1624" />
            <stroke android:width="1dp" android:color="#1A2D3D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Left cyan accent strip via inset -->
    <item android:right="0dp" android:top="0dp" android:bottom="0dp" android:left="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#2000BCD4"
                android:endColor="#000E1624" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
