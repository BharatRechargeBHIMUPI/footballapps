<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════╗
    ║  SPLASH SCREEN — EMERALD PITCH REDESIGN                  ║
    ║  Aesthetic: Fresh football pitch + stadium live feel      ║
    ║  Palette:   Emerald #065F46  |  Gold  #D4A843            ║
    ║             Mint   #10B981   |  Dark  #022C22            ║
    ║  All View IDs IDENTICAL to original — logic untouched     ║
    ╚══════════════════════════════════════════════════════════╝
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hero_bg">

    <!-- ═══════════════════════════════════════════════════════
         LAYER 1 — PITCH LINE OVERLAY (full screen, ghost)
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pitch_lines"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════════════════
         LAYER 2 — RADIAL EMERALD GLOW (centre)
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/bgGlow"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_center_glow"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3" />

    <!-- ═══════════════════════════════════════════════════════
         LAYER 3 — EXPANDING MINT PULSE RINGS
    ════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/ring1"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_emerald"
        android:alpha="0" />

    <View
        android:id="@+id/ring2"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_emerald"
        android:alpha="0" />

    <View
        android:id="@+id/ring3"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_emerald"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════════════════
         LIVE BADGE — top centre
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/liveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_live_badge_emerald"
        android:alpha="0">

        <View
            android:id="@+id/liveDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_mint_round"
            android:layout_marginEnd="7dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE TIPS"
            android:textColor="@color/live_dot_color"
            android:textSize="9sp"
            android:letterSpacing="0.30"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         TOP CORNER STAT BADGES
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="end"
        android:alpha="0.40">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIN RATE"
            android:textColor="@color/btn_gold"
            android:textSize="7sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="87%"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="52dp"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:gravity="start"
        android:alpha="0.40">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="@color/btn_gold"
            android:textSize="7sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12\nTIPS"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="0.88" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT BLOCK — centre
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_marginTop="-32dp">

        <!-- ── LOGO FRAME ─────────────────────────────────── -->
        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center">

            <!-- Slow-rotating outer ring -->
            <ImageView
                android:id="@+id/hexRing"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_logo_ring"
                android:alpha="0"
                android:scaleX="0.5"
                android:scaleY="0.5" />

            <!-- Gold halo ring -->
            <View
                android:id="@+id/logoRing"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_halo_gold"
                android:alpha="0"
                android:scaleX="0.6"
                android:scaleY="0.6" />

            <!-- App logo -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/logo"
                android:layout_width="98dp"
                android:layout_height="98dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_logo"
                android:alpha="0"
                android:scaleX="0.2"
                android:scaleY="0.2" />

        </FrameLayout>

        <!-- ── GOLD DIAMOND DIVIDER ───────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="52dp"
                android:layout_height="1dp"
                android:background="#40D4A843" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_diamond_gold"
                android:rotation="45" />

            <View
                android:layout_width="52dp"
                android:layout_height="1dp"
                android:background="#40D4A843" />

        </LinearLayout>

        <!-- ── APP NAME ───────────────────────────────────── -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="34sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:translationY="50dp"
            android:alpha="0" />

        <!-- ── GOLD GRADIENT UNDERLINE ────────────────────── -->
        <View
            android:id="@+id/underlineAccent"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_underline_gold_gradient" />

        <!-- ── TAGLINE ────────────────────────────────────── -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="PREDICT  •  WIN  •  DOMINATE"
            android:textColor="#BDD4A843"
            android:textSize="10sp"
            android:letterSpacing="0.30"
            android:fontFamily="sans-serif-condensed"
            android:translationY="30dp"
            android:alpha="0" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         BOTTOM SECTION — loading bar + dots + powered by
    ════════════════════════════════════════════════════════ -->

    <!-- Slim gold-to-mint progress bar -->
    <FrameLayout
        android:id="@+id/loadingBarContainer"
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/dotsLayout"
        android:layout_marginBottom="22dp"
        android:background="#1AFFFFFF"
        android:alpha="0">

        <View
            android:id="@+id/loadingBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_loading_bar_gold" />

    </FrameLayout>

    <!-- Square loading dots -->
    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/poweredBy"
        android:layout_marginBottom="18dp"
        android:alpha="0">

        <View
            android:id="@+id/dot1"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_gold_square" />

        <View
            android:id="@+id/dot2"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_gold_square" />

        <View
            android:id="@+id/dot3"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_dot_gold_square" />

    </LinearLayout>

    <!-- Powered-by label -->
    <TextView
        android:id="@+id/poweredBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:text="POWERED BY ACEAPPS"
        android:textColor="#40F0FDF8"
        android:textSize="8sp"
        android:letterSpacing="0.26"
        android:fontFamily="sans-serif-condensed"
        android:alpha="0" />

</RelativeLayout>