<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal fade bar — cyan centre, transparent ends (top card accent / underline) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#0000BCD4"
        android:centerColor="#CC00BCD4"
        android:endColor="#0000BCD4" />
    <corners android:radius="2dp" />
</shape>
