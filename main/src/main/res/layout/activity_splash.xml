<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050609">

    <!-- ═══════════════════════════════════════════
         BACKGROUND LAYERS
    ════════════════════════════════════════════ -->

    <!-- Deep radial glow behind logo -->
    <View
        android:id="@+id/bgGlow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_center_glow"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3" />

    <!-- Particle / grid mesh overlay (subtle) -->
    <View
        android:id="@+id/liveDot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0" />
    <View
        android:id="@+id/liveBadge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0" />
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════
         PULSE RINGS (3 staggered, expand outward)
    ════════════════════════════════════════════ -->
    <View
        android:id="@+id/ring1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_circle"
        android:alpha="0" />

    <View
        android:id="@+id/ring2"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_circle"
        android:alpha="0" />

    <View
        android:id="@+id/ring3"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_ring_circle"
        android:alpha="0" />

    <!-- ═══════════════════════════════════════════
         CENTER CONTENT
    ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Logo container -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center">

            <!-- Rotating hex ring behind logo -->
            <ImageView
                android:id="@+id/hexRing"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_logo_ring"
                android:alpha="0"
                android:scaleX="0.5"
                android:scaleY="0.5" />

            <!-- Amber glow halo tight around logo -->
            <View
                android:id="@+id/logoRing"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_ring"
                android:alpha="0"
                android:scaleX="0.6"
                android:scaleY="0.6" />

            <!-- App logo -->
            <de.hdodenhof.circleimageview.CircleImageView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/logo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_logo"
                android:alpha="0"
                android:scaleX="0.2"
                android:scaleY="0.2" />

        </FrameLayout>

        <!-- App name -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:letterSpacing="0.14"
            android:textStyle="bold"
            android:translationY="50dp"
            android:alpha="0" />

        <!-- Animated underline bar -->
        <View
            android:id="@+id/underlineAccent"
            android:layout_width="0dp"
            android:layout_height="2.5dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="#FF5733" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text="PREDICT  •  WIN  •  DOMINATE"
            android:textColor="#FF5733"
            android:textSize="11sp"
            android:letterSpacing="0.22"
            android:translationY="30dp"
            android:alpha="0" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         BOTTOM SECTION
    ════════════════════════════════════════════ -->

    <!-- Loading bar (horizontal progress strip) -->
    <FrameLayout
        android:id="@+id/loadingBarContainer"
        android:layout_width="160dp"
        android:layout_height="3dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/dotsLayout"
        android:layout_marginBottom="20dp"
        android:background="#1A1F2B"
        android:alpha="0">

        <View
            android:id="@+id/loadingBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#FF5733" />
    </FrameLayout>

    <!-- Loading dots -->
    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/poweredBy"
        android:layout_marginBottom="20dp"
        android:alpha="0">

        <View
            android:id="@+id/dot1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_accent" />

        <View
            android:id="@+id/dot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_accent" />

        <View
            android:id="@+id/dot3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_accent" />

    </LinearLayout>

    <!-- Powered by -->
    <TextView
        android:id="@+id/poweredBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:text="POWERED BY ACEAPPS"
        android:textColor="#33FFFFFF"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:alpha="0" />

</RelativeLayout>