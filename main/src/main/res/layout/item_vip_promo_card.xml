<?xml version="1.0" encoding="utf-8"?>
<!--
    DROP THIS CARD above your Live Match Analysis row.
    Give it a click listener in your Activity:
        findViewById<View>(R.id.vipPromoCard).setOnClickListener { ... }
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vipPromoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:elevation="6dp">

    <!-- ── Base card background (dark warm) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_plan_card_selected"
        android:padding="0dp">



        <!-- ── Main content row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Left: trophy + text block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- TOP LABEL row: live dot + VIP -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <!-- Pulsing dot (static in XML) -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_accent"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXCLUSIVE  ·  LIMITED OFFER"
                        android:textColor="#FF5733"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18" />
                </LinearLayout>

                <!-- Big headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock All VIP"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Predictions ⚡"
                    android:textColor="#FF5733"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="8dp" />

                <!-- Stat pills row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Pill 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ 99% Win Rate"
                        android:textColor="#00C853"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="6dp" />

                    <!-- Pill 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 7 Streak"
                        android:textColor="#FFB800"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: CTA button + trophy emoji -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="12dp">

                <!-- Trophy -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="34sp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- CTA button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET VIP"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_subscribe_button"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Bottom strip: social proof ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="#33FF5733"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 50,000+ members winning daily  ·  Cancel anytime"
                android:textColor="#FFCCBB"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Decorative corner watermark ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="56dp"
        android:text="VIP"
        android:textColor="#1AFF5733"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

</FrameLayout>