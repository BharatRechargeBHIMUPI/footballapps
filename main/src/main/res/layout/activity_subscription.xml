<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/bg_subs">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="30dp"
            android:id="@+id/btnClose"
            android:src="@drawable/ic_paywall_close"
            android:layout_height="30dp"/>


    </LinearLayout>


    <!-- ═══════════════════════════════════════════════════
         5 — STICKY CTA
    ═══════════════════════════════════════════════════ -->


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:layout_alignParentBottom="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ═══════════════════════════════════════════════════
                     1 — TOP BAR
                ═══════════════════════════════════════════════════ -->

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvPlanTitle"
                        android:layout_marginEnd="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.035"
                        android:layout_gravity="center"
                        android:lineSpacingExtra="-4dp"
                        android:text="Correct Score"
                        android:textColor="#ffffff"
                        android:textSize="27dp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="60dp"
                        android:src="@drawable/ic_pro"
                        android:layout_gravity="center"
                        android:layout_height="35dp"/>

                </androidx.appcompat.widget.LinearLayoutCompat>


                <LinearLayout
                    android:id="@+id/featuresSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="10dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:layout_weight="1"
                            android:id="@+id/feature1"
                            layout="@layout/pw_item_feature"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />



                        <include
                            android:layout_weight="1"
                            android:id="@+id/feature2"
                            layout="@layout/pw_item_feature"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />




                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/feature3"
                            layout="@layout/pw_item_feature"
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/feature4"
                            layout="@layout/pw_item_feature"
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />





                    </LinearLayout>

                </LinearLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentBottom="true"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <!-- LOADING -->
                            <LinearLayout
                                android:id="@+id/loadingState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="20dp"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:padding="26dp">

                                <ProgressBar
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:indeterminateTint="#224EF4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:fontFamily="monospace"
                                    android:text="@string/loading_passes"
                                    android:textColor="#8E9B92"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <!-- WEEKLY -->
                            <FrameLayout
                                android:id="@+id/planWeekly"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/pw_plan_selected"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <!-- POPULAR BADGE -->
                                <TextView
                                    android:id="@+id/badgeWeeklyPopular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_marginEnd="14dp"
                                    android:translationY="-14dp"
                                    android:elevation="10dp"
                                    android:background="@drawable/pw_badge_bg"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/popular"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- WEEKLY CONTENT -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="20dp">


                                    <TextView
                                        android:id="@+id/tvWeeklyRadio"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:background="@drawable/pw_radio_unselected"
                                        android:gravity="center" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvWeeklyTitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-black"
                                            android:text="@string/weekly_pass"
                                            android:textColor="#FFFFFF"
                                            android:textSize="17sp" />

                                        <TextView
                                            android:id="@+id/tvWeeklySubtitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="@string/try_for_one_week_cancel_anytime"
                                            android:textColor="#8A8F9C"
                                            android:textSize="9sp" />

                                        <TextView
                                            android:id="@+id/tvWeeklyBreakdown"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:text="Weekly $71.00"
                                            android:textColor="#5282FC"
                                            android:textSize="10sp"
                                            android:visibility="gone"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvWeeklyPrice"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-black"
                                            android:text="$500"
                                            android:textColor="#5282FC"
                                            android:textSize="17sp" />

                                        <TextView
                                            android:id="@+id/tvWeeklyPeriod"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="/ Weekly"
                                            android:textColor="#5A5F6C"
                                            android:textSize="12sp" />

                                    </LinearLayout>

                                </LinearLayout>

                            </FrameLayout>


                            <!-- MONTHLY -->
                            <FrameLayout
                                android:id="@+id/planMonthly"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/pw_plan_unselected">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="20dp">


                                    <TextView
                                        android:id="@+id/tvMonthlyRadio"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:background="@drawable/pw_radio_selected"
                                        android:gravity="center"
                                        android:text="✓"
                                        android:textColor="#FFFFFF"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvMonthlyTitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-black"
                                            android:text="@string/monthly_pass"
                                            android:textColor="#5A5F6C"
                                            android:textSize="17sp" />

                                        <TextView
                                            android:id="@+id/tvMonthlySubtitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="@string/full_season_access_best_value"
                                            android:textColor="#4A4E58"
                                            android:textSize="9sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvMonthlyPrice"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-black"
                                            android:text="$1000"
                                            android:textColor="#5A5F6C"
                                            android:textSize="17sp" />


                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="/ Monthly"
                                            android:textColor="#5A5F6C"
                                            android:textSize="12sp" />

                                    </LinearLayout>


                                </LinearLayout>

                            </FrameLayout>

                        </LinearLayout>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/ctaBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/pw_scrim"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/btnSubscribe"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/pw_cta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscribe_vip"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:textSize="15sp" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_dot" />


                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="@string/privacy_policy"
                    android:textColor="#B2B2B2"
                    android:textSize="10.5sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_dot" />

                <TextView
                    android:id="@+id/tvRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="@string/restore_purchases"
                    android:textColor="#B2B2B2"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>


    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>