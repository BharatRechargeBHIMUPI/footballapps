<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fillViewport="true">

    <LinearLayout
        android:background="@drawable/bg_paywall_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Header with Gradient Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- Close Button -->


            <!-- Hero Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="32dp">

                <!-- VIP Badge -->

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vip_badge"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  VIP MEMBERSHIP"
                            android:textColor="#FFD700"
                            android:textSize="9sp"
                            android:letterSpacing="0.15"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnClose"
                        android:layout_centerVertical="true"
                        android:layout_width="30dp"
                        android:layout_alignParentEnd="true"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_close"
                        android:contentDescription="Close"/>
                </RelativeLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvPlanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2+ Odds VIP"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium predictions. Real results."
                    android:textColor="#B0B0CC"
                    android:textSize="13sp"
                    android:layout_marginVertical="6dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Stats Strip -->
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stats_strip"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-15dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="94%"
                    android:textColor="#7C6EF5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Win Rate"
                    android:textColor="#888899"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#2A2A3A" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50K+"
                    android:textColor="#7C6EF5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Members"
                    android:textColor="#888899"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#2A2A3A" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily"
                    android:textColor="#7C6EF5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Picks"
                    android:textColor="#888899"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Features Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What's Included"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Feature 1 -->
            <include layout="@layout/item_feature"
                android:id="@+id/feature1" />

            <!-- Feature 2 -->
            <include layout="@layout/item_feature"
                android:id="@+id/feature2" />

            <!-- Feature 3 -->
            <include layout="@layout/item_feature"
                android:id="@+id/feature3" />
            <!-- Feature 3 -->


        </LinearLayout>


        <!-- Plans Container -->

        <!-- Trust Section -->


        <!-- CTA Section -->
        <View
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="0dp"/>

        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Loading State (shown while fetching) -->
            <LinearLayout
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="#7C6EF5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading plans..."
                    android:textColor="#888899"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Plan Cards (populated dynamically) -->
            <!-- Weekly Plan Card (example, populated by code) -->
            <FrameLayout
                android:id="@+id/planWeekly"
                android:layout_width="match_parent"
                android:background="@drawable/bg_plan_card_unselected"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWeeklyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWeeklySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Try before you commit"
                                android:textColor="#888899"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvWeeklyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$4.99"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per week"
                                android:textColor="#888899"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Monthly Plan Card -->
            <FrameLayout
                android:id="@+id/planMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plan_card_selected"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <!-- Most Popular Badge -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMonthlyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monthly"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMonthlySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best value for serious Users"
                                android:textColor="#C0BBFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvMonthlyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$14.99"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per month"
                                android:textColor="#C0BBFF"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Savings strip -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#3A3580"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp" />




                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💰  Save 40% vs weekly plan"
                            android:textColor="#7C6EF5"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/badgeMonthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOST POPULAR"
                            android:textColor="#0A0A0F"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:background="@drawable/bg_popular_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_gravity="top|end" />


                    </androidx.appcompat.widget.LinearLayoutCompat>
                </LinearLayout>
            </FrameLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="5dp"
            android:paddingBottom="1dp">

            <!-- Subscribe Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubscribe"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="Get VIP Access Now"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_subscribe_button" />

            <!-- Restore Purchases -->


            <!-- Legal Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="10dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#555566"
                    android:textSize="11sp"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="#555566"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restore Purchases"
                    android:textColor="#555566"
                    android:textSize="11sp"
                    android:padding="4dp" />


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
