<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="14dp">

    <!-- Icon Circle -->
    <TextView
        android:id="@+id/tvFeatureIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:text="✓"
        android:textColor="#7C6EF5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_feature_icon" />

    <!-- Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvFeatureTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feature Title"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFeatureDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feature description goes here"
            android:textColor="#888899"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
