<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tips"
    android:layout_marginBottom="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <!-- ══════════════════════════════════════════ -->
            <!--  HEADER ROW — league · time · status       -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">



                <!-- Country · League -->
                <TextView
                    android:id="@+id/tvCountry"
                    android:layout_width="0dp"
                    android:layout_marginEnd="10dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="India · Premier League"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />




                <!-- Status badge -->
                <RelativeLayout
                    android:id="@+id/rlStatus"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_status_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENDING"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />


                </RelativeLayout>
            </LinearLayout>

            <!-- Full-width hairline divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0F1520"
                android:layout_marginEnd="0dp" />

            <!-- ══════════════════════════════════════════ -->
            <!--  DATE                                       -->
            <!-- ══════════════════════════════════════════ -->


            <!-- ══════════════════════════════════════════ -->
            <!--  TEAMS + SCORE                             -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="14dp">

                <!-- HOME TEAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Logo box with orange accent ring -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center">



                        <RelativeLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="13dp"
                            app:cardBackgroundColor="#111827"
                            android:background="@drawable/bg_flags"
                            >

                            <TextView
                                android:id="@+id/ivHomeLogo1"
                                android:layout_centerInParent="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="30sp"
                                android:text="🏠" />
                        </RelativeLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvHomeTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mumbai FC"
                        android:textColor="#E8EDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- HOME label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME"
                        android:textColor="#434B5D"
                        android:textSize="8sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- CENTER: SCORE or VS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="0.85"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Score panel -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="14dp"
                        app:strokeColor="#0F1520"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="12dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Friday, 10 April 2026"
                                android:textColor="#ffffff"
                                android:textSize="9sp"
                                android:textAlignment="center"
                                android:gravity="center"/>

                            <TextView
                                android:id="@+id/tvScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 - 2"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />


                            <TextView
                                android:id="@+id/tvScoreLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="F T"
                                android:textColor="#00C853"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.3" />

                            <TextView
                                android:layout_marginTop="10dp"
                                android:id="@+id/tvLeagueTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="20:11"
                                android:textColor="#ffffff"
                                android:background="@drawable/bg_date_tips"
                                android:textSize="9sp"
                                android:letterSpacing="0.08"
                                android:padding="10dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- VS label (pre-match) -->
                    <TextView
                        android:id="@+id/tvVs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VS"
                        android:textColor="#1A2233"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- AWAY TEAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center">



                        <RelativeLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="13dp"
                            app:cardBackgroundColor="#111827"
                            android:background="@drawable/bg_flags"
                            >

                            <TextView
                                android:id="@+id/ivHomeLogo2"
                                android:layout_centerInParent="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="30sp"
                                android:text="🏠" />
                        </RelativeLayout>
                    </FrameLayout>


                    <TextView
                        android:id="@+id/tvAwayTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Delhi SC"
                        android:textColor="#E8EDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- AWAY label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AWAY"
                        android:textColor="#434B5D"
                        android:textSize="8sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/odds"
                android:layout_marginHorizontal="50dp"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:gravity="end"
                android:layout_marginBottom="3dp" />

            <!-- ══════════════════════════════════════════ -->
            <!--  PREDICTION STRIP (bottom full-width)      -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_date_tips"
                android:paddingHorizontal="12dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp">

                <!-- "OUR PICK" micro label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/our_pick"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginEnd="10dp" />
                <!-- "OUR PICK" micro label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginEnd="10dp" />

                <!-- Pick chip -->
                <TextView
                    android:id="@+id/tvPick"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Over 2.5 Goals"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Spacer -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <!-- ODDS label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">



                    <!-- Odds value -->
                    <TextView
                        android:id="@+id/tvOdds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.85"
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/bg_odds_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>