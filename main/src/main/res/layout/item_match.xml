<?xml version="1.0" encoding="utf-8"?>
<!--
  item_match_card.xml — DARK MATTER premium redesign
  All view IDs preserved exactly. No logic changes needed.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#080B12"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_primary"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <!-- ══════════════════════════════════════════ -->
            <!--  HEADER ROW — league · time · status       -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <!-- Pulsing dot -->
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot_accent"
                    android:layout_marginEnd="9dp" />

                <!-- Country · League -->
                <TextView
                    android:id="@+id/tvCountry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="India · Premier League"
                    android:textColor="#C8D0E0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Time chip -->
                <TextView
                    android:id="@+id/tvLeagueTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:11"
                    android:textColor="@color/app_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:background="@drawable/bg_plan_card_unselected"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textSize="8sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_status_pending" />
            </LinearLayout>

            <!-- Full-width hairline divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0F1520"
                android:layout_marginEnd="0dp" />

            <!-- ══════════════════════════════════════════ -->
            <!--  DATE                                       -->
            <!-- ══════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Friday, 10 April 2026"
                android:textColor="#ffffff"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:paddingEnd="14dp" />

            <!-- ══════════════════════════════════════════ -->
            <!--  TEAMS + SCORE                             -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"
                android:paddingEnd="14dp">

                <!-- HOME TEAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Logo box with orange accent ring -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center">



                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="13dp"
                            app:cardBackgroundColor="#111827"
                            app:strokeColor="@color/app_primary"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/ivHomeLogo1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="22sp"
                                android:text="🏠" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvHomeTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mumbai FC"
                        android:textColor="#E8EDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- HOME label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME"
                        android:textColor="#ffffff"
                        android:textSize="8sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- CENTER: SCORE or VS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="0.85"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Score panel -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#040608"
                        app:cardCornerRadius="14dp"
                        app:strokeColor="#0F1520"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="12dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 - 2"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <!-- Orange underline accent -->
                            <View
                                android:layout_width="28dp"
                                android:layout_height="2dp"
                                android:background="@color/app_primary"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvScoreLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="F T"
                                android:textColor="#00C853"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- VS label (pre-match) -->
                    <TextView
                        android:id="@+id/tvVs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VS"
                        android:textColor="#1A2233"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- AWAY TEAM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center">


                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="13dp"
                            app:cardBackgroundColor="#111827"
                            app:strokeColor="@color/app_primary"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/ivHomeLogo2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="22sp"
                                android:text="✈️" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvAwayTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Delhi SC"
                        android:textColor="#E8EDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- AWAY label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AWAY"
                        android:textColor="#ffffff"
                        android:textSize="8sp"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════════ -->
            <!--  PREDICTION STRIP (bottom full-width)      -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0A0D15"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingVertical="12dp">

                <!-- "OUR PICK" micro label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUR PICK"
                    android:textColor="#ffffff"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginEnd="10dp" />

                <!-- Pick chip -->
                <TextView
                    android:id="@+id/tvPick"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Over 2.5 Goals"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pick_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" />

                <!-- Spacer -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <!-- ODDS label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ODDS"
                        android:textColor="#ffffff"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"
                        android:gravity="center"
                        android:layout_marginBottom="3dp" />

                    <!-- Odds value -->
                    <TextView
                        android:id="@+id/tvOdds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.85"
                        android:textSize="15sp"
                        android:textColor="#00C853"
                        android:textStyle="bold"
                        android:background="@drawable/bg_odds_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>