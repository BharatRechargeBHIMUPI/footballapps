<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/pw_item_feature.xml
    Keeps the same three IDs your setupFeatures() looks up:
    tvFeatureIcon / tvFeatureTitle / tvFeatureDesc
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tvFeatureIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⚡"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFeatureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Expert Picks"
            android:textColor="#F2EEE3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFeatureDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="2dp"
            android:text="Hand-curated predictions delivered every morning"
            android:textColor="#8E9B92"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="✓"
        android:textColor="#2FBF62"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
