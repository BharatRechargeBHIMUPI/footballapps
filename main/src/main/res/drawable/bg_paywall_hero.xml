<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base deep dark navy -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A1A" />
        </shape>
    </item>

    <!-- Purple radial glow from top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300%"
                android:startColor="#557C6EF5"
                android:endColor="#007C6EF5"
                android:centerX="0.85"
                android:centerY="0.1" />
        </shape>
    </item>

    <!-- Diagonal sweep: dark bottom-left to transparent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#CC0A0A1A"
                android:centerColor="#660A0A1A"
                android:endColor="#000A0A1A" />
        </shape>
    </item>

    <!-- Bottom fade to page background so it blends seamlessly -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF0A0A0F"
                android:endColor="#000A0A0F" />
        </shape>
    </item>

</layer-list>