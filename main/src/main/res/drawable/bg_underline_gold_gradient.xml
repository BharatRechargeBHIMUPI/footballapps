<?xml version="1.0" encoding="utf-8"?>
<!-- bg_underline_gold_gradient.xml -->
<!-- Sweeping gold-to-transparent gradient underline bar -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#00D4A843"
        android:centerColor="#FFD4A843"
        android:endColor="#00D4A843" />
    <corners android:radius="1dp" />
</shape>
