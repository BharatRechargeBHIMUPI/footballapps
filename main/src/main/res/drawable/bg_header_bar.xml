<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background with gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#080C12"
                android:endColor="#0D1520" />
            <stroke android:color="#1A2D3D" android:width="1dp" />
        </shape>
    </item>
    <!-- Left cyan accent bar -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:color="#00BCD4" android:width="3dp" />
        </shape>
    </item>
</layer-list>
