<?xml version="1.0" encoding="utf-8"?>
<!-- bg_center_glow.xml — deep forest green radial glow -->
<!-- Replaces the original orange glow; stadium floodlight feel -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#4D1A6B2F"
        android:centerColor="#261A4A20"
        android:endColor="#000B1A0F" />
</shape>
