<?xml version="1.0" encoding="utf-8"?>
<!-- bg_accent_bar.xml — replaces bg_underline_gold_gradient
     Wide bar: purple → violet → transparent, left-aligned feel -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#8B30D0"
        android:centerColor="#C060FF"
        android:endColor="#00000000" />
    <corners android:radius="1dp" />
</shape>
