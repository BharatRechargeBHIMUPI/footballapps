<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  fragment_daily_free_match.xml — REDESIGNED                  ║
    ║  Aesthetic: Live odds terminal / match ticker                 ║
    ║  Palette:   Slate #080C12 | Cyan #00BCD4 | Gold #F4C430     ║
    ║                                                              ║
    ║  ALL VIEW IDs IDENTICAL — zero Kotlin logic changes          ║
    ║  IDs preserved: btnBack, txtTitle, txtNote, tabLayout,       ║
    ║                 tabToday, tabYesterday, rvMatches,           ║
    ║                 txtNoHistory, bottomLayout, txtTotal         ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════════
         HEADER BAR
         New: flush top bar with cyan left-border + live badge
    ════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_header_bar"
        android:paddingHorizontal="16dp">

        <!-- Back button — square icon badge -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="@color/app_primary"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Title + breadcrumb sub-label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintEnd_toStartOf="@+id/livePill"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Free Match"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREE PREDICTIONS"
                android:textColor="@color/text_secondary"
                android:textSize="8sp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.18"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Live pill — right aligned -->
        <LinearLayout
            android:id="@+id/livePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_live_pill_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_live_dot_cyan"
                android:layout_marginEnd="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="@color/app_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Header bottom glow line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_header_divider_cyan" />

    <!-- ═══════════════════════════════════════════════════════
         NOTE STRIP
         New: left-bordered info banner — no card wrapper
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/txtNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_note_strip_slate"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        android:paddingVertical="11dp">

        <!-- Left cyan accent bar -->
        <View
            android:layout_width="3dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_cyan_bar_rounded"
            android:layout_marginEnd="12dp" />

        <!-- Info icon -->
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_info"
            android:tint="@color/app_primary"
            android:contentDescription="Note"
            android:layout_marginEnd="8dp" />

        <!-- Note text -->
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Stake games singles before combining"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.02" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         TAB SWITCHER
         New: segmented pill inside dark card — no outer card stroke
         Active tab = cyan solid; Inactive = ghost with dim text
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_container"
        android:padding="4dp">

        <!-- TODAY tab — active state by default -->
        <TextView
            android:id="@+id/tabToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="TODAY"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:background="@drawable/bg_tab_active_cyan" />

        <!-- YESTERDAY tab — inactive state by default -->
        <TextView
            android:id="@+id/tabYesterday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:text="YESTERDAY"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:background="@drawable/bg_tab_inactive_slate" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         MATCH COUNT STRIP
         New: lightweight row showing match count + date chip
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Vertical accent + label -->
        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_cyan_bar_rounded"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MATCHES"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.20" />

        <!-- Date chip — right side -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="TODAY"
            android:textColor="@color/app_primary"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14" />

    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_divider_fade" />

    <!-- ═══════════════════════════════════════════════════════
         MATCHES LIST + EMPTY STATE
    ════════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- Empty state — centered, styled -->
        <LinearLayout
            android:id="@+id/txtNoHistory"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="36sp"
                android:layout_gravity="center"
                android:alpha="0.35" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No games yet"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Check back soon for predictions"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed"
                android:alpha="0.6" />

        </LinearLayout>

    </RelativeLayout>

    <!-- ═══════════════════════════════════════════════════════
         BOTTOM COMBINED ODDS BAR
         New: floating panel — gold odds value, cyan ACCUM badge,
              shimmer top-border, stat row above total
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_odds_panel"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- Top shimmer line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_gold_bar_fade"
            android:layout_marginBottom="14dp" />

        <!-- Main odds row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: label + big odds value -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- COMBINED ODDS label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_gold_bar_rounded"
                        android:layout_marginEnd="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMBINED ODDS"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.14" />
                </LinearLayout>

                <!-- Big gold odds number -->
                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_gold"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="-0.02"
                    tools:text="14.50" />

            </LinearLayout>

            <!-- Right: ACCUMULATOR badge + match count -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- ACCUMULATOR badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCUMULATOR"
                    android:textColor="@color/app_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.14"
                    android:background="@drawable/bg_accum_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />

                <!-- Small help text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Stake singles first"
                    android:textColor="@color/text_tertiary"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>