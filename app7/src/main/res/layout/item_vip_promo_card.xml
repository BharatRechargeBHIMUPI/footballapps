<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  item_vip_promo_card.xml — REDESIGNED                        ║
    ║  Same ID: vipPromoCard / btnVip / btnTodayPicks              ║
    ║  New look: Dark slate with cyan+gold data panel aesthetic    ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vipPromoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_promo_card_slate">

        <!-- ── MAIN CONTENT ROW ─────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- LEFT: text block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top label: live pulse dot + caption -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_live_dot_cyan"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXCLUSIVE  ·  LIMITED OFFER"
                        android:textColor="@color/app_primary"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-condensed" />
                </LinearLayout>

                <!-- Headline line 1 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock All VIP"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:fontFamily="sans-serif-condensed" />

                <!-- Headline line 2 — gold accent -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Predictions ⚡"
                    android:textColor="@color/accent_gold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginBottom="10dp" />

                <!-- Stat pills row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Win rate pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ 99% Win Rate"
                        android:textColor="#00E5FF"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pill_cyan_dim"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="sans-serif-condensed" />

                    <!-- Streak pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 7 Streak"
                        android:textColor="@color/accent_gold"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pill_gold_dim"
                        android:fontFamily="sans-serif-condensed" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT: icon + CTA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="14dp">

                <!-- Score display — data feel -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="32sp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- GET VIP button — cyan solid -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET VIP"
                    android:textColor="@color/app_bg"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-condensed"
                    android:background="@drawable/bg_subscribe_button_cyan"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── BOTTOM STRIP — social proof ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/bg_promo_bottom_strip"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 50,000+ members winning daily  ·  Cancel anytime"
                android:textColor="@color/text_secondary"
                android:textSize="8.5sp"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

    </LinearLayout>

    <!-- Watermark: large dim "VIP" text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="52dp"
        android:text="VIP"
        android:textColor="#12F4C430"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-condensed" />

</FrameLayout>
